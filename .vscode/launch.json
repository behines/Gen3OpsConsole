  "version": "0.2.0",
  "configurations": [
    {
      "name": "PyDbg: MasterControl",
      "type": "debugpy",
      "request": "launch",
      "program": "MasterControl.py",
      "console": "integratedTerminal",
      //"args": [
      //  "${command:pickArgs}"
      //]
    },
    {
      "name": "PyDbg: Current File ",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      //"args": [
      //  "${command:pickArgs}"
      //]
    },
    {
      "name": "PyDbg: CurFile w/ Args",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "args": [
        "${command:pickArgs}"
      ]
    }  ]
}
