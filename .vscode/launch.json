  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: MasterControl",
      "type": "debugpy",
      "request": "launch",
      "program": "MasterControl.py",
      "console": "integratedTerminal",
      //"args": [
      //  "${command:pickArgs}"
      //]
    },
    {
      "name": "Python Debugger: Current File with Arguments",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      //"args": [
      //  "${command:pickArgs}"
      //]
    }
  ]
}
